# ==============================================================================
# Tesla Browser Maps - Environment Variables (.env.local)
# ==============================================================================

# Google Maps JavaScript API Key
# დარწმუნდით, რომ Google Cloud Console-ში გააქტიურებულია შემდეგი API-ები:
# 1. Maps JavaScript API
# 2. Places API (New) / Places API
# 3. Directions API
# 4. Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Project Configuration
# მოიპოვეთ Supabase Dashboard -> Project Settings -> API-დან
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# (სურვილისამებრ) Default Map Center - თბილისის კოორდინატები საწყის წერტილად
NEXT_PUBLIC_DEFAULT_LAT=41.7151
NEXT_PUBLIC_DEFAULT_LNG=44.8271
NEXT_PUBLIC_DEFAULT_ZOOM=14
